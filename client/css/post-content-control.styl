@import colors

.post-container
    .post-content.transparency-grid img
        background-image:
            linear-gradient(45deg, $transparency-grid-square-color 25%, transparent 25%),
            linear-gradient(-45deg, $transparency-grid-square-color 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, $transparency-grid-square-color 75%),
            linear-gradient(-45deg, transparent 75%, $transparency-grid-square-color 75%)
        background-size: 20px 20px
        background-position: 0 0, 0 10px, 10px -10px, -10px 0px

    text-align: center
    .post-content
        text-align: left
        margin: 0 auto
        position: relative

        .resize-listener
            position: absolute
            left: 0
            right: 0
            top: 0
            bottom: 0
            width: 100%
            height: 100%

        img
            image-orientation: from-image

        .pdf-viewer
            overflow: auto
            background: #525659
            color: #FFF
            text-align: center

            .pdf-toolbar
                position: sticky
                z-index: 1
                top: 0
                display: flex
                flex-wrap: wrap
                align-items: center
                justify-content: center
                gap: 0.5em
                min-height: 3.5em
                padding: 0.25em
                box-sizing: border-box
                background: #323639

                button
                    min-height: 2.75em
                    padding: 0.4em 0.7em
                    border: 1px solid #777
                    border-radius: 0.25em
                    background: #424649

                    &:disabled
                        opacity: 0.5

            .pdf-page
                display: block
                margin: 1em auto
                max-width: 100%
                background: #FFF
                box-shadow: 0 1px 5px #222

            .pdf-status
                min-height: 1.5em
                padding: 0.5em

            button, a
                color: #FFF

            a
                margin-left: 1em

    @media (max-width: 600px)
        .post-content
            .pdf-viewer
                .pdf-toolbar
                    gap: 0.25em

                    button
                        min-height: 2.5em
                        padding: 0.35em 0.45em
                        font-size: 0.85em

                .pdf-page
                    margin: 0.5em auto
